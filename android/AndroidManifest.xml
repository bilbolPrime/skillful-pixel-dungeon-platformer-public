<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="com.android.vending.BILLING" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/app_icon"
        android:roundIcon="@drawable/app_icon"
        android:isGame="true"
        android:appCategory="game"
        android:label="@string/app_name"
        android:theme="@style/GdxTheme" >

        <!--
            Google Play Games Services app ID.
            The value is read from res/values/game-ids.xml.
            Replace REPLACE_WITH_GPGS_APP_ID in that file with your real app ID.
        -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/gpgs_app_id" />

        <activity
            android:name="com.bilboldev.skillfulpixeldungeonplatformer.AndroidLauncher"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
